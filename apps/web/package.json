{
  "name": "@ragab/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:static": "astro build && npx --yes serve dist -l 4173",
    "typecheck": "astro check",
    "deploy": "astro build && wrangler pages deploy dist --project-name=ragab-web"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.7.3",
    "@ragab/content-schema": "workspace:*",
    "@ragab/themes": "workspace:*",
    "@ragab/ui": "workspace:*",
    "astro": "^5.13.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.1"
  }
