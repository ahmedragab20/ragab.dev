---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TerminalApp } from "../components/TerminalApp";
import { site } from "../data/site";
import { loadTerminalContent, withoutBodies } from "../lib/content";
import { bioSummary, personLd, websiteLd } from "../lib/seo";

export const prerender = true;

const { blogs, announcements } = await loadTerminalContent();
// Meta only on the home island — full bodies live on /blog/[slug]
const leanBlogs = withoutBodies(blogs);
const leanAnnouncements = withoutBodies(announcements);
const description = bioSummary(site);
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={description}
  path="/"
  jsonLd={[personLd(site), websiteLd(site)]}
>
  <main id="content" style="height: 100%">
    <h1 class="sr-only">{site.name} — {site.role}</h1>
    <p class="sr-only">
      {site.bio.join(" ")}
      {
        site.experience?.length
          ? `Work history: ${site.experience.map((e) => `${e.role} at ${e.org}`).join(", ")}.`
          : ""
      }
      {
        site.projects.length
          ? `Projects: ${site.projects.map((p) => `${p.name} — ${p.description}`).join(" ")}`
          : ""
      }
      Commands: help, tour, browse, whoami, projects, blogs, contact, theme
      list. Blog index at /blog.
    </p>
    <nav class="sr-only" aria-label="Site">
      <ul>
        <li><a href="/blog">Blog</a></li>
        <li><a href={`mailto:${site.contact.email}`}>Email</a></li>
        {
          (["github", "twitter", "linkedin"] as const).map((key) => {
            const value = site.contact[key];
            if (!value) return null;
            const href = value.startsWith("http") ? value : `https://${value}`;
            const label = key === "twitter" ? "X" : key;
            return (
              <li>
                <a href={href}>{label}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <TerminalApp
      client:idle={{ timeout: 200 }}
      blogs={leanBlogs}
      announcements={leanAnnouncements}
      boot={{ mode: "home" }}
    />
  </main>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
