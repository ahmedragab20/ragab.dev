---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TerminalApp } from "../../components/TerminalApp";
import {
  loadTerminalContent,
  withOnlyBody,
  withoutBodies,
} from "../../lib/content";

export const prerender = true;

export async function getStaticPaths() {
  const { blogs } = await loadTerminalContent();
  return blogs.map((post) => ({
    params: { slug: post.slug },
    props: {
      slug: post.slug,
      title: post.title,
      excerpt: post.excerpt,
      date: post.date,
      body: post.body ?? "",
    },
  }));
}

const { slug, title, excerpt, date, body } = Astro.props;
const { blogs, announcements } = await loadTerminalContent();
// Only this post carries a body into the island
const leanBlogs = withOnlyBody(blogs, slug);
const leanAnnouncements = withoutBodies(announcements);
---

<BaseLayout
  title={`${title ?? slug} — ragab.dev`}
  description={excerpt ?? "Blog post"}
  path={`/blog/${slug}`}
  ogType="article"
>
  <main id="terminal" style="height: 100%">
    <TerminalApp
      client:idle={{ timeout: 200 }}
      blogs={leanBlogs}
      announcements={leanAnnouncements}
      boot={{ mode: "blog", slug }}
    />
  </main>
</BaseLayout>

{
  /* Crawlable article for SEO / no-JS */
}
{
  body && (
    <article class="sr-only">
      <h1>{title}</h1>
      <time datetime={date}>{date}</time>
      {excerpt ? <p>{excerpt}</p> : null}
      <pre>{body}</pre>
      <p>
        <a href="/blog">All posts</a>
        {" · "}
        <a href="/">Home</a>
      </p>
    </article>
  )
}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
