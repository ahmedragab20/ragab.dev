---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TerminalApp } from "../../components/TerminalApp";
import { loadTerminalContent, withoutBodies } from "../../lib/content";
import { blogLd, type BlogMeta } from "../../lib/seo";
import { site } from "../../data/site";

export const prerender = true;

const { blogs, announcements } = await loadTerminalContent();
const leanBlogs = withoutBodies(blogs);
const leanAnnouncements = withoutBodies(announcements);
const metas: BlogMeta[] = blogs.map(({ slug, title, date, updated, excerpt, tags }) => ({
  slug,
  title,
  date,
  updated,
  excerpt,
  tags,
}));
---

<BaseLayout
  title="Blog — Ahmed Ragab"
  description="Writing and notes from Ahmed Ragab"
  path="/blog"
  jsonLd={blogLd(metas, site)}
>
  <main id="content" style="height: 100%">
    <h1 class="sr-only">Blog</h1>
    <nav class="sr-only" aria-label="Posts">
      <ul>
        {
          blogs.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                {post.title}
                {post.excerpt ? ` — ${post.excerpt}` : ""}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <TerminalApp
      client:idle={{ timeout: 200 }}
      blogs={leanBlogs}
      announcements={leanAnnouncements}
      boot={{ mode: "blogs" }}
    />
  </main>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
