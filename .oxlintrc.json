{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/storybook-static/**",
    "**/prototypes/**",
    "**/node_modules/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "off",
    "unicorn/filename-case": "off"
  }
}
